{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K-Snake X11 Control Center",
  "version": "1.0.0",
  "identifier": "com.ksnake.x11.control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "K-Snake X11 Control Center",
        "width": 1240,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
